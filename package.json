{
  "name": "party-macro-manager",
  "version": "1.1.0",
  "description": "WoW addon that auto-creates interrupt macros based on party position",
  "private": true,
  "type": "module",
  "addon": {
    "title": "Party Macro Manager",
    "notes": "Auto-creates interrupt macros based on party position",
    "author": "Darcilynn",
    "interface": [
      "120000",
      "110207",
      "50503",
      "38000",
      "20505",
      "11508"
    ],
    "savedVariables": [
      "PartyMacroManagerDB"
    ],
    "optionalDeps": [
      "WoWUnit"
    ],
    "loadOrder": [
      "index.lua"
    ]
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "watch": "npm run dev",
    "transpile": "tstl",
    "lint": "npm run lint:ts && npm run lint:js && npm run lint:lua && npm run lint:workflows",
    "lint:ts": "tsc --noEmit",
    "lint:js": "eslint scripts/**/*.{js,mjs,cjs} src/**/*.ts",
    "lint:lua": "luacheck tests/ --config .luacheckrc",
    "lint:workflows": "actionlint .github/workflows/*.yml",
    "lint:fix": "npm run lint:js -- --fix && prettier --write \"src/**/*.ts\"",
    "test": "npm run build && vitest run",
    "test:update-baseline": "npm run build && node -e \"import('./bundlesize.test.js')\"",
    "test:bundlesize:update": "npm run build && node bundlesize.test.js",
    "package": "npm run build"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@eslint/js": "^9.39.2",
    "@johnnymorganz/stylua-bin": "^2.3.1",
    "@types/node": "^25.0.10",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@typescript-to-lua/language-extensions": "^1.19.0",
    "archiver": "^7.0.1",
    "chokidar": "^3.6.0",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "glob": "^13.0.0",
    "globals": "^17.1.0",
    "lua-types": "^2.13.1",
    "luacheck": "^0.1.2",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3",
    "typescript-to-lua": "^1.33.2",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "wow",
    "addon",
    "world-of-warcraft"
  ],
  "author": "Darcilynn",
  "license": "MIT",
  "volta": {
    "node": "22.22.0",
    "npm": "11.8.0"
  }
}
