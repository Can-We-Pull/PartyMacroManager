# Optional: Set your WoW client path here to override auto-detection
# Useful if you have multiple WoW installations or non-standard paths
# Point to the root of your client version (e.g., _retail_, _classic_era_, _classic_)
# The script will automatically append /Interface/AddOns/PartyMacroManager

# WOW_RETAIL_PATH=/path/to/World of Warcraft/_retail_

# Examples:
# Linux (native): WOW_RETAIL_PATH=/home/username/Games/World of Warcraft/_retail_
# Linux (Wine): WOW_RETAIL_PATH=/home/username/.wine/drive_c/Program Files (x86)/World of Warcraft/_retail_
# Linux (Bottles): WOW_RETAIL_PATH=/home/username/.var/app/com.usebottles.bottles/data/bottles/bottles/World-of-Warcraft/drive_c/Program Files (x86)/World of Warcraft/_retail_
# macOS: WOW_RETAIL_PATH=/Applications/World of Warcraft/_retail_
# Windows: WOW_RETAIL_PATH=C:/Program Files (x86)/World of Warcraft/_retail_
# WSL: WOW_RETAIL_PATH=/mnt/c/Program Files (x86)/World of Warcraft/_retail_

# Classic Era
# WOW_CLASSIC_PATH=/path/to/World of Warcraft/_classic_era_

# Classic (Cataclysm)
# WOW_CLASSIC_CATA_PATH=/path/to/World of Warcraft/_classic_
